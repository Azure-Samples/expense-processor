{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "//model": "Authenticate to this Azure OpenAI deployment with DefaultAzureCredential.",
    "AZURE_FUNCTIONS_AGENTS_PROVIDER": "azure_openai",
    "AZURE_OPENAI_ENDPOINT": "https://<your-openai-account>.openai.azure.com/",
    "AZURE_OPENAI_DEPLOYMENT": "<your-deployment-name>",

    "//policy": "Copy POLICY_MCP_SERVER_URL from `azd env get-values`; leave the client ID empty to use your developer credential.",
    "POLICY_MCP_SERVER_URL": "",
    "POLICY_MCP_CLIENT_ID": ""
  }
}
